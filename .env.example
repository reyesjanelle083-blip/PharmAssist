# Copy to .env and replace every value. Never commit .env.

# --- Laravel apps (shared by gateway and all four services) ---
APP_ENV=local
APP_DEBUG=false
# Generate with:
#   docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=base64:replace_me_with_generated_key
# Shared secret for service-to-service calls (X-Internal-Key). Use a long random string.
INTERNAL_SERVICE_KEY=change_me

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me
IDENTITY_DB_PASSWORD=change_me
INVENTORY_DB_PASSWORD=change_me
RESERVATION_DB_PASSWORD=change_me
INTEGRATION_DB_PASSWORD=change_me

# JWT signing secret: use a random string of at least 32 characters.
# Shared by the identity-service (signs tokens) and the gateway (verifies them) ONLY.
# Generate: docker run --rm php:8.3-cli php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change_me

# Browser origins allowed to call the gateway (comma separated, never *)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- integration-service: distance (OSRM) ---
INTEGRATION_MODE=live
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=1.5
OSRM_RETRIES=1
# Put a real contact (for example an email) in your own .env, never in git.
HTTP_USER_AGENT="PharmAssistSIA/1.0 (replace with a contact email)"
HAVERSINE_ROAD_FACTOR=1.3
HAVERSINE_AVG_SPEED_KMH=25
DISTANCE_FORCE_FAIL=false
