# Copy to .env and replace every value. Never commit .env.

# --- Laravel apps (shared by gateway and all four services) ---
APP_ENV=local
APP_DEBUG=false
# Generate with:
#   docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=base64:replace_me_with_generated_key
# Shared secret for service-to-service calls (X-Internal-Key). Use a long random string.
INTERNAL_SERVICE_KEY=change_me

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me
IDENTITY_DB_PASSWORD=change_me
INVENTORY_DB_PASSWORD=change_me
RESERVATION_DB_PASSWORD=change_me
INTEGRATION_DB_PASSWORD=change_me

# JWT signing secret: use a random string of at least 32 characters.
# Shared by the identity-service (signs tokens) and the gateway (verifies them) ONLY.
# Generate: docker run --rm php:8.3-cli php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change_me

# Browser origins allowed to call the gateway (comma separated, never *)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- integration-service: distance (OSRM) ---
INTEGRATION_MODE=live
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=1.8
OSRM_RETRIES=0
OSRM_DEADLINE_SECONDS=1.8
# Put a real contact (for example an email) in your own .env, never in git.
HTTP_USER_AGENT="PharmAssistSIA/1.0 (replace with a contact email)"
HAVERSINE_ROAD_FACTOR=1.3
HAVERSINE_AVG_SPEED_KMH=25
DISTANCE_FORCE_FAIL=false

# --- integration-service: prescription OCR (local Tesseract) ---
OCR_PROVIDER=tesseract
# Docker needs no setting here: the container has Tesseract on the PATH (docker-compose.yml defaults TESSERACT_BIN to "tesseract"). Do NOT set it
# in this file: editors and shells that load the root .env into terminals would then override the real path in services/integration-service/.env
# and OCR would silently be "unavailable" on a local Windows run. Set the full path in services/integration-service/.env instead
# (forward slashes inside double quotes, never backslashes inside double quotes).
# TESSERACT_BIN=tesseract
OCR_PSM=6
OCR_TIMEOUT_SECONDS=15
OCR_MIN_CONFIDENCE=0.6
OCR_MAX_CONCURRENT=2
OCR_FORCE_FAIL=false

# --- gateway: how long the gateway waits for an OCR answer (every other route waits 3 s). Keep it above OCR_TIMEOUT_SECONDS.
GATEWAY_OCR_TIMEOUT_SECONDS=20
# --- gateway: how long the gateway waits for each step of the inventory feed sync (translate, then apply)
GATEWAY_SYNC_TIMEOUT_SECONDS=10
# --- gateway: how long it waits for POST /reservations and PATCH /reservations/{id}/status. reservation-service may make inventory calls and, with a prescription photo, one OCR call (up to 20 s): keep this above that. GET routes wait 3 s
# (RESERVATION_URL is set for the gateway by docker-compose.yml)
GATEWAY_RESERVATION_TIMEOUT_SECONDS=30
# --- gateway: how long it waits for integration-service's distance answer before estimating distances itself
# (HAVERSINE_ROAD_FACTOR and HAVERSINE_AVG_SPEED_KMH above are used by the gateway too)
GATEWAY_DISTANCE_TIMEOUT_SECONDS=2.5
# --- integration-service: largest inventory feed accepted, in KB
FEED_MAX_KB=512

# --- reservation-service: how long a reservation (and its stock hold) lasts, in hours
RESERVATION_TTL_HOURS=48
