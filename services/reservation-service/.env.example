APP_NAME=reservation-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8003

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reservation_db
DB_USERNAME=reservation_user
DB_PASSWORD=change_me

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

SERVICE_NAME=reservation-service
INTERNAL_SERVICE_KEY=change_me

# inventory-service: stock holds and the medicine catalog (called with the internal key, 3 s timeout, POST never retried)
INVENTORY_URL=http://127.0.0.1:8002
# integration-service: prescription OCR will be connected in a later step (not called yet)
INTEGRATION_URL=http://127.0.0.1:8004
# How long a reservation lasts; the stock hold is created with the same lifetime
RESERVATION_TTL_HOURS=48
