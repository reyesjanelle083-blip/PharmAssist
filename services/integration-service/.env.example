APP_NAME=integration-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8004

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=integration_db
DB_USERNAME=integration_user
DB_PASSWORD=change_me

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

SERVICE_NAME=integration-service
INTERNAL_SERVICE_KEY=change_me

# --- Distance / OSRM (see README) ---
# live = real providers, stub = deterministic fake data and no network (refused in production unless ALLOW_STUB_IN_PRODUCTION=true)
INTEGRATION_MODE=live
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=1.8
# 0 = a single attempt (default). The retry code is still there: OSRM_RETRIES=1 enables one retry.
OSRM_RETRIES=0
# Hard limit across all attempts; must stay well below the gateway's 3 s
OSRM_DEADLINE_SECONDS=1.8
# Sent to OSRM as the User-Agent. Put a real contact (for example an email) in your own .env, never in git.
HTTP_USER_AGENT="PharmAssistSIA/1.0 (replace with a contact email)"
HAVERSINE_ROAD_FACTOR=1.3
HAVERSINE_AVG_SPEED_KMH=25
# true makes OSRM fail immediately so the fallback can be tested (plan T12)
DISTANCE_FORCE_FAIL=false

# --- Prescription OCR (local Tesseract, see README) ---
# tesseract | stub (INTEGRATION_MODE=stub always uses the stub)
OCR_PROVIDER=tesseract
# Path of the Tesseract binary. A bare name is looked up on the PATH.
# Windows: use forward slashes inside double quotes, or single quotes. Backslashes inside double quotes break the whole .env file.
#   TESSERACT_BIN="C:/Program Files/Tesseract-OCR/tesseract.exe"
#   TESSERACT_BIN='C:\Program Files\Tesseract-OCR\tesseract.exe'
TESSERACT_BIN=tesseract
# Page segmentation mode (6 = one uniform block of text)
OCR_PSM=6
OCR_TIMEOUT_SECONDS=15
# Below this mean word confidence (0 to 1) the result is "low_confidence"
OCR_MIN_CONFIDENCE=0.6
# How many OCR jobs may run at the same time; more callers get OCR_BUSY
OCR_MAX_CONCURRENT=2
# true makes every OCR attempt fail at once (testing only; refused in production unless ALLOW_STUB_IN_PRODUCTION=true)
OCR_FORCE_FAIL=false
