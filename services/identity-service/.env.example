APP_NAME=identity-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=identity_db
DB_USERNAME=identity_user
DB_PASSWORD=change_me

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

SERVICE_NAME=identity-service
INTERNAL_SERVICE_KEY=change_me

# Password for the seeded test accounts (local/dev only; the seeder refuses to run in production)
SEED_PASSWORD=change_me

# Outgoing email (password reset codes). "log" only writes the message into the log: use it for local work. Set smtp (and MAIL_HOST,
# MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD) to really send email. With "log" the code is in the logged message: that is Laravel's mailer, not the app.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@pharmassist.test
MAIL_FROM_NAME=PharmAssist

# HS256 signing secret for access tokens. Must be set (min 32 characters) or login fails closed.
JWT_SECRET=change_me
