APP_NAME=inventory-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8002

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_db
DB_USERNAME=inventory_user
DB_PASSWORD=change_me

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

SERVICE_NAME=inventory-service
INTERNAL_SERVICE_KEY=change_me

# Hours a stock hold lasts before the expiry job releases it
INVENTORY_HOLD_TTL_HOURS=48
