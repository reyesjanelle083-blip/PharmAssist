APP_NAME=gateway
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

SERVICE_NAME=gateway
INTERNAL_SERVICE_KEY=change_me

# Must equal identity-service JWT_SECRET (min 32 characters); the gateway only verifies tokens
JWT_SECRET=change_me
IDENTITY_URL=http://127.0.0.1:8001
INVENTORY_URL=http://127.0.0.1:8002
CORS_ALLOWED_ORIGINS=http://localhost:5173
INTEGRATION_URL=http://127.0.0.1:8004
# Seconds the gateway waits for an OCR answer; every other route waits 3 s. Keep it above the integration-service OCR_TIMEOUT_SECONDS.
GATEWAY_OCR_TIMEOUT_SECONDS=20
# Seconds the gateway waits for each step of the inventory feed sync (translate, then apply).
GATEWAY_SYNC_TIMEOUT_SECONDS=10
# reservation-service base URL
RESERVATION_URL=http://127.0.0.1:8003
# Seconds the gateway waits for POST /reservations and PATCH /reservations/{id}/status (the service makes up to two
# calls to inventory-service, and, with a prescription photo, one OCR call to integration-service). GET routes wait 3 s.
GATEWAY_RESERVATION_TIMEOUT_SECONDS=30
# Seconds the gateway waits for integration-service's distance answer; after that it estimates the distances itself (haversine).
GATEWAY_DISTANCE_TIMEOUT_SECONDS=2.5
# The gateway's own estimate (same meaning and defaults as in integration-service)
HAVERSINE_ROAD_FACTOR=1.3
HAVERSINE_AVG_SPEED_KMH=25
