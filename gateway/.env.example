APP_NAME=gateway
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

SERVICE_NAME=gateway
INTERNAL_SERVICE_KEY=change_me

# Must equal identity-service JWT_SECRET (min 32 characters); the gateway only verifies tokens
JWT_SECRET=change_me
IDENTITY_URL=http://127.0.0.1:8001
CORS_ALLOWED_ORIGINS=http://localhost:5173
