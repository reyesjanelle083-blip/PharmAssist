      "name": "99 Rate limit (run last)",
      "item": [
        {
          "name": "T31 Rate limit on login returns 429",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.info.iteration === 0 && !pm.environment.get('rl_attempts')) { pm.environment.set('rl_attempts', '0'); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var attempts = parseInt(pm.environment.get('rl_attempts') || '0', 10) + 1;",
                  "pm.environment.set('rl_attempts', String(attempts));",
                  "var limited = pm.response.code === 429;",
                  "if (!limited && attempts < 20) {",
                  "  pm.execution.setNextRequest('T31 Rate limit on login returns 429'); // keep hammering until limited",
                  "} else {",
                  "  pm.environment.unset('rl_attempts');",
                  "  var body = pm.response.json();",
                  "  pm.test('a 429 appeared within 20 attempts (got it after ' + attempts + ')', function () { pm.expect(limited).to.be.true; });",
                  "  pm.test('status is 429', function () { pm.response.to.have.status(429); });",
                  "  pm.test('envelope has all six keys', function () {",
                  "    ['status', 'service', 'request_id', 'data', 'error', 'warnings'].forEach(function (k) { pm.expect(body).to.have.property(k); });",
                  "  });",
                  "  pm.test('request_id is non-empty', function () { pm.expect(body.request_id).to.be.a('string').and.not.empty; });",
                  "  pm.test('error.code is TOO_MANY_REQUESTS', function () { pm.expect(body.error.code).to.eql('TOO_MANY_REQUESTS'); });",
                  "  pm.test('Retry-After header exists', function () { pm.expect(pm.response.headers.has('Retry-After')).to.be.true; });",
                  "  pm.test('error comes from the gateway', function () { pm.expect(body.service).to.eql('gateway'); });",
                  "}"
                ]
              }
            }
          ],
