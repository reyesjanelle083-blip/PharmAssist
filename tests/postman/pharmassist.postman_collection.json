{
  "info": {
    "name": "PharmAssist - Auth through the gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Functional and negative tests for the auth endpoints, called through the API gateway (base_url).\n\nRun from the repository root so the id.png fixture path resolves. See tests/postman/README.md.\n\nNOTE: email verification with the 6-digit code (POST /auth/verify-email) is NOT tested here. The code is only written to the local identity-service log (APP_ENV=local) and no email is sent yet, so a collection cannot read it. That path is covered by the identity-service PHPUnit tests.\n\nOrder matters: 01 Auth, 02 Negative, then 99 Rate limit last. The login limit is 10 per minute per IP and this whole collection counts toward it, so wait 60 seconds between runs.\n\nSecrets: the seeded password is NOT stored in any file. Supply it with --env-var \"seed_password=<password>\" or paste it into the environment in Postman."
  },
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "T01 Register valid customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var email = 'postman.' + Date.now() + '.' + Math.floor(Math.random() * 10000) + '@pharmassist.test';",
                  "pm.environment.set('random_email', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.test('envelope has all six keys', function () {",
                  "  ['status', 'service', 'request_id', 'data', 'error', 'warnings'].forEach(function (k) { pm.expect(body).to.have.property(k); });",
                  "});",
                  "pm.test('request_id is non-empty', function () { pm.expect(body.request_id).to.be.a('string').and.not.empty; });",
                  "pm.test('envelope status matches HTTP status', function () { pm.expect(body.status).to.eql(201); });",
                  "pm.test('verification_status is pending', function () { pm.expect(body.data.verification_status).to.eql('pending'); });",
                  "pm.test('role is customer and email not verified', function () {",
                  "  pm.expect(body.data.role).to.eql('customer');",
                  "  pm.expect(body.data.email_verified).to.eql(false);",
                  "});",
                  "pm.test('email matches the generated random_email', function () { pm.expect(body.data.email).to.eql(pm.environment.get('random_email')); });",
                  "pm.test('no sensitive fields leaked', function () {",
                  "  var text = pm.response.text();",
                  "  pm.expect(text).to.not.include('password_hash');",
                  "  pm.expect(text).to.not.include('id_document_path');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "email",
                  "value": "{{random_email}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{seed_password}}",
                  "type": "text"
                },
                {
                  "key": "first_name",
                  "value": "Postman",
                  "type": "text"
                },
                {
                  "key": "last_name",
                  "value": "Tester",
                  "type": "text"
                },
                {
                  "key": "contact_no",
                  "value": "09171234567",
                  "type": "text"
                },
                {
                  "key": "id_photo",
                  "type": "file",
                  "src": "tests/postman/fixtures/id.png"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "T03 Login valid approved customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('envelope has all six keys', function () {",
                  "  ['status', 'service', 'request_id', 'data', 'error', 'warnings'].forEach(function (k) { pm.expect(body).to.have.property(k); });",
                  "});",
                  "pm.test('request_id is non-empty', function () { pm.expect(body.request_id).to.be.a('string').and.not.empty; });",
                  "pm.test('envelope status matches HTTP status', function () { pm.expect(body.status).to.eql(200); });",
                  "pm.test('token_type is Bearer and expires_in is 3600', function () {",
                  "  pm.expect(body.data.token_type).to.eql('Bearer');",
                  "  pm.expect(body.data.expires_in).to.eql(3600);",
                  "});",
                  "pm.test('access_token has three dot-separated parts', function () {",
                  "  pm.expect(body.data.access_token).to.be.a('string');",
                  "  pm.expect(body.data.access_token.split('.')).to.have.lengthOf(3);",
                  "});",
                  "pm.test('user is the approved customer', function () {",
                  "  pm.expect(body.data.user.email).to.eql(pm.environment.get('email_customer_approved'));",
                  "  pm.expect(body.data.user.role).to.eql('customer');",
                  "});",
                  "pm.environment.set('access_token', body.data.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_customer_approved}}\",\n  \"password\": \"{{seed_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
